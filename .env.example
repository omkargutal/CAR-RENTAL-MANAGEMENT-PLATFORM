# ==============================================================================
# AUTOFLEET CAR RENTAL PLATFORM - CENTRAL ENVIRONMENT CONFIGURATION
# ==============================================================================
# All configuration is validated via Pydantic Settings in backend/app/core/config.py
# Copy this file to .env and customize for your production deployment.

# ------------------------------------------------------------------------------
# APPLICATION METADATA & RUNTIME
# ------------------------------------------------------------------------------
PROJECT_NAME="Car Rental Management Platform"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
API_V1_STR=/api/v1

# Secret key for JWT session hashing & token signatures (generate with `openssl rand -hex 32`)
SECRET_KEY=replace_with_a_secure_random_32_byte_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
ALGORITHM=HS256

# Allowed CORS Origins (JSON array string or comma separated)
BACKEND_CORS_ORIGINS=["https://yourdomain.com","http://localhost","http://localhost:80"]

# ------------------------------------------------------------------------------
# SECURITY, COOKIES & RATE LIMITING
# ------------------------------------------------------------------------------
REFRESH_COOKIE_NAME=carrental_refresh_token
REFRESH_COOKIE_HTTPONLY=true
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Sliding-window rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL 16 with btree_gist)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=carrental_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=carrental_db

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# OBJECT STORAGE (MinIO / AWS S3 Compatible)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://yourdomain.com/storage
S3_ACCESS_KEY=replace_with_secure_minio_root_user
S3_SECRET_KEY=replace_with_secure_minio_root_password
S3_BUCKET_NAME=carrental-uploads
S3_REGION=us-east-1
S3_USE_SSL=false

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY INTEGRATION (Razorpay / Stripe)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR

# Optional Stripe Integration
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# META WHATSAPP BUSINESS PLATFORM (Cloud API)
# ------------------------------------------------------------------------------
# Obtained from Meta Developer Portal (https://developers.facebook.com)
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_WABA_ID=your_whatsapp_business_account_id
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_access_token
WHATSAPP_VERIFY_TOKEN=autofleet_webhook_token_2026
WHATSAPP_BUSINESS_NUMBER=9876543210
WHATSAPP_APP_ID=your_meta_app_id
WHATSAPP_APP_SECRET=your_meta_app_secret

# ------------------------------------------------------------------------------
# NOTIFICATIONS & EMAIL (SMTP)
# ------------------------------------------------------------------------------
NOTIFICATION_PROVIDER=stub
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
EMAILS_FROM_EMAIL=noreply@yourdomain.com
EMAILS_FROM_NAME="AutoFleet Car Rental"

# ------------------------------------------------------------------------------
# INGRESS & REVERSE PROXY (Caddy with automatic HTTPS)
# ------------------------------------------------------------------------------
# Set DOMAIN to your public DNS domain (e.g. rental.example.com).
# Caddy will automatically issue and renew Let's Encrypt / ZeroSSL TLS certificates.
DOMAIN=rental.example.com
CADDY_EMAIL=admin@yourdomain.com

# ------------------------------------------------------------------------------
# AUTOMATED BACKUPS
# ------------------------------------------------------------------------------
BACKUP_STORAGE_PATH=/var/backups/carrental
BACKUP_RETENTION_DAYS=14
